    },
    "intake_id": {
      "minLength": 1,
      "title": "Intake Id",
      "type": "string"
    },
    "screen_id": {
      "minLength": 1,
      "title": "Screen Id",
      "type": "string"
    },
    "assessment_stage": {
      "$ref": "#/$defs/AssessmentStage"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/EligibilityOutcome"
    },
