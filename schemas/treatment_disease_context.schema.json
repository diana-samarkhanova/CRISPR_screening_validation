{
  "$defs": {
    "BiomarkerAxisObservationStatus": {
      "description": "Curator-visible availability state for a typed biomarker bundle.",
      "enum": [
        "observed",
        "not_assessed",
        "not_reported",
        "insufficient_material",
        "unknown"
      ],
      "title": "BiomarkerAxisObservationStatus",
      "type": "string"
    },
    "BiomarkerFeatureType": {
      "enum": [
        "genomic_mutation",
        "copy_number",
        "fusion",
        "rna_expression",
        "protein_expression",
        "epigenetic",
        "genomic_signature",
        "functional_status",
        "other"
      ],
      "title": "BiomarkerFeatureType",
      "type": "string"
    },
    "InterventionModality": {
      "enum": [
        "small_molecule",
        "antibody",
        "cell_therapy",
        "gene_therapy",
        "radiotherapy",
        "combination",
        "other",
        "unknown"
      ],
      "title": "InterventionModality",
      "type": "string"
    },
    "MolecularMeasurementTimepoint": {
      "enum": [
        "pretreatment",
        "on_treatment",
        "post_treatment",
        "unknown"
      ],
      "title": "MolecularMeasurementTimepoint",
      "type": "string"
    },
    "PerturbationModality": {
      "enum": [
        "CRISPR_KO",
        "CRISPRa",
        "CRISPRi",
        "RNAi",
        "overexpression",
        "mutation",
        "inhibitor",
        "other"
      ],
      "title": "PerturbationModality",
      "type": "string"
    },
    "PerturbedCompartment": {
      "description": "Cell compartment in which the perturbation was introduced.",
      "enum": [
        "tumor_cell",
        "immune_cell",
        "other",
        "unknown"
      ],
      "title": "PerturbedCompartment",
      "type": "string"
    },
    "RegimenComponentRelation": {
      "description": "How listed canonical active components form a regimen.",
      "enum": [
        "fixed_all_of",
        "alternative_one_of",
        "none",
        "unresolved"
      ],
      "title": "RegimenComponentRelation",
      "type": "string"
    },
    "ScreenEndpointCategory": {
      "enum": [
        "drug_response_viability",
        "immune_killing",
        "immune_cell_fitness",
        "marker_expression",
        "other",
        "unknown"
      ],
      "title": "ScreenEndpointCategory",
      "type": "string"
    }
  },
