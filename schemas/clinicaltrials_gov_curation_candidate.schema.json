      "default": null,
      "title": "Source Treatment Locator"
    },
    "source_condition_locator": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Condition Locator"
    },
    "source_treatment_text": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
