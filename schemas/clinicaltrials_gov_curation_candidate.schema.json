      "title": "Candidate Id",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_study_id": {
      "pattern": "^NCT\\d{8}$",
      "title": "Source Study Id",
      "type": "string"
    },
    "source_family_id": {
      "minLength": 1,
      "title": "Source Family Id",
      "type": "string"
    },
