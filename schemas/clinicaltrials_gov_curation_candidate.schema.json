      "minimum": 1,
      "title": "Source Page Index",
      "type": "integer"
    },
    "source_study_index": {
      "minimum": 0,
      "title": "Source Study Index",
      "type": "integer"
    },
    "source_intervention_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
