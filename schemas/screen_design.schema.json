{
  "$defs": {
    "ReplicateUnit": {
      "enum": [
        "independent_infection",
        "biological_culture",
        "technical_split",
        "unknown"
      ],
      "title": "ReplicateUnit",
      "type": "string"
    },
    "ScreenScale": {
      "enum": [
        "genome_wide",
        "targeted",
        "saturation",
        "other",
        "unknown"
      ],
      "title": "ScreenScale",
      "type": "string"
    },
    "SelectionStrategy": {
      "enum": [
        "positive_selection",
        "negative_selection",
        "bidirectional_selection",
        "competitive_growth",
        "marker_sort",
        "other",
        "unknown"
      ],
      "title": "SelectionStrategy",
      "type": "string"
    },
    "SourceRole": {
      "enum": [
        "original_screen",
        "protocol",
        "reanalysis",
        "validation_only",
        "review",
        "other"
      ],
      "title": "SourceRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
