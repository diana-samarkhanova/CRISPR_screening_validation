{
  "$defs": {
    "BiomarkerAxisObservationStatus": {
      "description": "Curator-visible availability state for a typed biomarker bundle.",
      "enum": [
        "observed",
        "not_assessed",
        "not_reported",
        "insufficient_material",
        "unknown"
      ],
      "title": "BiomarkerAxisObservationStatus",
      "type": "string"
    },
    "BiomarkerFeatureType": {
      "enum": [
        "genomic_mutation",
        "copy_number",
        "fusion",
        "rna_expression",
        "protein_expression",
        "epigenetic",
        "genomic_signature",
        "functional_status",
        "other"
      ],
      "title": "BiomarkerFeatureType",
      "type": "string"
    },
    "ComparatorExposureType": {
      "description": "Whether a comparator arm contains an active therapeutic exposure.",
      "enum": [
        "active_therapeutic",
        "placebo",
        "vehicle",
        "no_active_therapeutic",
        "unresolved"
      ],
      "title": "ComparatorExposureType",
      "type": "string"
    },
    "InteractionEffectScale": {
      "description": "Controlled interaction-effect scales with a known statistical null.",
      "enum": [
        "additive_coefficient",
        "difference_in_effect",
        "hazard_ratio",
        "odds_ratio",
        "risk_ratio",
        "ratio_of_ratios"
      ],
      "title": "InteractionEffectScale",
      "type": "string"
    },
    "InteractionInferenceStatus": {
      "description": "Curated conclusion of a formal treatment-by-predictor interaction test.",
      "enum": [
        "not_tested",
        "supported",
        "null",
        "inconclusive",
        "unsupported"
      ],
      "title": "InteractionInferenceStatus",
      "type": "string"
    },
    "InteractionPValueRole": {
      "description": "Inferential question answered by a reported interaction p-value.",
      "enum": [
        "departure_from_null",
        "equivalence_to_null"
      ],
      "title": "InteractionPValueRole",
      "type": "string"
    },
    "MolecularMeasurementTimepoint": {
      "enum": [
        "pretreatment",
        "on_treatment",
        "post_treatment",
        "unknown"
      ],
      "title": "MolecularMeasurementTimepoint",
      "type": "string"
    },
    "PatientAssociationInterpretation": {
      "enum": [
        "predictive_interaction",
        "interaction_tested_null",
        "interaction_tested_inconclusive",
        "interaction_tested_unsupported",
        "treated_cohort_association",
        "prognostic_only",
        "pharmacodynamic",
        "acquired_resistance",
        "on_treatment_association",
        "post_progression_association",
        "eligibility_only",
        "descriptive_only",
        "unresolved"
      ],
      "title": "PatientAssociationInterpretation",
      "type": "string"
    },
    "RegimenComponentRelation": {
      "description": "How listed canonical active components form a regimen.",
      "enum": [
        "fixed_all_of",
        "alternative_one_of",
        "none",
        "unresolved"
      ],
      "title": "RegimenComponentRelation",
      "type": "string"
    }
  },
  "additionalProperties": false,
