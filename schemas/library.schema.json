{
  "$defs": {
    "PerturbationModality": {
      "enum": [
        "CRISPR_KO",
        "CRISPRa",
        "CRISPRi",
        "RNAi",
        "overexpression",
        "mutation",
        "inhibitor",
        "other"
      ],
      "title": "PerturbationModality",
      "type": "string"
    },
    "ScreenScale": {
      "enum": [
        "genome_wide",
        "targeted",
        "saturation",
        "other",
        "unknown"
      ],
      "title": "ScreenScale",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "library_id": {
      "minLength": 1,
      "title": "Library Id",
      "type": "string"
    },
    "library_name": {
      "minLength": 1,
      "title": "Library Name",
      "type": "string"
    },
    "library_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Library Version"
    },
    "perturbation_modality": {
      "$ref": "#/$defs/PerturbationModality"
    },
    "library_scope": {
      "$ref": "#/$defs/ScreenScale",
      "default": "unknown"
    },
    "target_gene_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Gene Count"
    },
    "total_guide_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Guide Count"
    },
    "expected_guides_per_gene": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Guides Per Gene"
    },
    "nontargeting_guide_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nontargeting Guide Count"
    },
    "vector_architecture": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vector Architecture"
    },
    "enzyme": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Enzyme"
    },
    "guide_target_region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Guide Target Region"
    },
    "reference_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Url"
    },
    "source_locator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Locator"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "library_id",
    "library_name",
    "perturbation_modality"
  ],
  "title": "LibraryRecord",
  "type": "object"
}