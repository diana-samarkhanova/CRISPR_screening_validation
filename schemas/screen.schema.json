      "enum": [
        "CRISPR_KO",
        "CRISPRa",
        "CRISPRi",
        "RNAi",
        "overexpression",
        "mutation",
        "inhibitor",
        "other"
      ],
      "title": "PerturbationModality",
      "type": "string"
    },
    "PhenotypeDirection": {
